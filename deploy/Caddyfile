{
    email {$ACME_EMAIL}
    log default {
        output stderr
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers delete
                headers delete
                resp_headers delete
            }
        }
    }
}

{$DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    encode zstd gzip
    reverse_proxy web:80
}
