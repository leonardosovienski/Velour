# Velour — variáveis de ambiente (copie para .env e ajuste)

# Ambiente: development | test | production
APP_ENV=development

# Conexão do banco. Em produção, use postgresql+psycopg://usuario:senha@host/banco.
DATABASE_URL=sqlite:///./velour.db

# Segredo do JWT — GERE UM NOVO para produção (ex.: openssl rand -hex 32)
SECRET_KEY=troque-por-um-segredo-gerado-aleatoriamente
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480

# Origens do frontend separadas por vírgula. Obrigatória em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Diretório persistente para fotos e execução do job de aniversário.
UPLOAD_DIR=./uploads
SCHEDULER_ENABLED=true

# Apenas desenvolvimento. Em produção o schema é gerenciado pelo Alembic.
AUTO_CREATE_TABLES=true

# SMTP para e-mails transacionais (confirmação e lembrete de agendamento).
# Deixe em branco para desativar o envio de e-mails (a aplicação continua
# funcionando normalmente, só não envia notificações).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Velour <no-reply@velour.example.com>
SMTP_USE_TLS=true
