# Velour — variáveis de ambiente (copie para .env e ajuste)

# Ambiente: development | test | production
APP_ENV=development

# Conexão do banco. Em produção, use postgresql+psycopg://usuario:senha@host/banco.
DATABASE_URL=sqlite:///./velour.db

# Segredo do JWT — GERE UM NOVO para produção (ex.: openssl rand -hex 32)
SECRET_KEY=troque-por-um-segredo-gerado-aleatoriamente
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480

# Origens do frontend separadas por vírgula. Obrigatória em produção.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Diretório persistente para fotos e execução do job de aniversário.
UPLOAD_DIR=./uploads
SCHEDULER_ENABLED=true

# Apenas desenvolvimento. Em produção o schema é gerenciado pelo Alembic.
AUTO_CREATE_TABLES=true

# SaaS. APP_URL deve ser a origem HTTPS real em produção.
APP_URL=http://localhost:5173
SIGNUP_ENABLED=false
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=2026-09-08
PASSWORD_RESET_EXPIRE_MINUTES=30

# Stripe: um Price mensal recorrente. Nunca coloque chaves em VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_LIVEMODE=false

# Docker Compose: use senhas hexadecimais aleatórias (sem caracteres de URL).
POSTGRES_PASSWORD=
# Com compose.production.yaml, Caddy emite/renova HTTPS.
DOMAIN=
ACME_EMAIL=
# Um fuso operacional para todos os salões desta implantação.
SALON_TIMEZONE=America/Sao_Paulo

# SMTP para e-mails transacionais (confirmação e lembrete de agendamento).
# SMTP é obrigatório para abrir cadastros em produção e recuperar contas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Velour <no-reply@velour.example.com>
SMTP_USE_TLS=true

# Nível de log (DEBUG, INFO, WARNING, ERROR). Logs são emitidos em JSON,
# um objeto por linha, no stdout — prontos para agregação por qualquer
# coletor de logs (CloudWatch, Loki, journald, etc).
LOG_LEVEL=INFO
